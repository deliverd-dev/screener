# Copy to .env and fill in what you have. Everything is optional:
# with nothing set, Screener is a playground on your own machine.

# A real model. Pick one.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # or http://localhost:11434/v1 for Ollama
# SCREENER_MODEL=                                      # the model's name, if not the default

# Real people for the "needs a person" moments, through Deliverd.
# An agent key from your Deliverd organisation (https://deliverd.dev)
# DELIVERD_API_KEY=
# DELIVERD_APPROVERS=ops,security   # people or teams; your admins when empty

# PORT=4173
# HOST=127.0.0.1   # keep it on your machine unless you know why not
